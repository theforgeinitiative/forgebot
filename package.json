{
  "name": "forgebot",
  "version": "0.1.0",
  "private": true,
  "description": "The Forge Initiative Discord bot",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "deploy-commands": "node dist/deploy-commands.js",
    "deploy-commands:dev": "node --env-file=.env src/deploy-commands.ts --guild",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@googleapis/sheets": "^10.0.1",
    "discord.js": "^14.28.1",
    "jsforce": "^3.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
