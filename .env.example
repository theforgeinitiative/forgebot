# Discord — application + bot token from the Developer Portal.
# Use a separate dev application for local work; two processes on the same
# token both answer every interaction.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_MEMBER_ROLE_ID=
DISCORD_WELCOME_CHANNEL_ID=

# Salesforce — same connected app / names as the member portal.
# Use the sandbox login URL outside production.
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_STORAGE_CAMPAIGN_ID=

# igloohome — OAuth client credentials for the storage unit locks
IGLOOHOME_CLIENT_ID=
IGLOOHOME_CLIENT_SECRET=

# Storage — text appended to every unlock DM (contains gate codes; keep secret)
STORAGE_ADDITIONAL_INSTRUCTIONS=

# Storage unlock log (Google Sheets). Optional: unset → unlocks aren't logged.
# GOOGLE_SERVICE_ACCOUNT_JSON is the full service-account key JSON on one line;
# share the sheet with the service account's email as an editor.
STORAGE_LOG_SHEET_ID=
STORAGE_LOG_SHEET_NAME=Log
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared logins for /password, one group of variables per site (any number).
# URL, USERNAME and PASSWORD are required; TOTP_SECRET is the base32 2FA key
# and NAME the label shown in Discord, both optional. Secrets: keep private.
# SHARED_LOGIN_BAMBU_NAME=Bambu Lab
# SHARED_LOGIN_BAMBU_URL=https://bambulab.com
# SHARED_LOGIN_BAMBU_USERNAME=
# SHARED_LOGIN_BAMBU_PASSWORD=
# SHARED_LOGIN_BAMBU_TOTP_SECRET=
# Optional: seconds the site still accepts an expired 2FA code (extends the countdown shown)
# SHARED_LOGIN_BAMBU_TOTP_SLACK=30

# Runtime. TZ defaults to America/New_York in code; PORT is set by Railway.
# PORT=3000
